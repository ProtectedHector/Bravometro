# URL pública generada por `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Clerk: autenticación social. Habilita Google, Apple y, opcionalmente, Facebook/X.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Places API (New), solo servidor. Restringe la clave a la API y al entorno.
GOOGLE_MAPS_API_KEY=

# Maps JavaScript API, visible en el navegador. Usa una clave distinta,
# restringida por sitios web y exclusivamente a Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ID de mapa para Advanced Markers. En desarrollo se usa DEMO_MAP_ID si falta.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# URL canónica de producción, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token largo y aleatorio. Debe configurarse también en Convex.
# Nunca expongas este valor mediante NEXT_PUBLIC_*.
BRAVOMETRO_ADMIN_TOKEN=

# Token servidor-a-servidor para aportaciones autenticadas.
# Debe existir con el mismo valor en Next.js/Vercel y Convex.
BRAVOMETRO_SERVICE_TOKEN=
